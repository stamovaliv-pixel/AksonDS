# Copy values into Supabase Dashboard → Edge Functions → Secrets.
# Do NOT commit a real proxy secret or place it into browser files.
DOXI_TUNNEL_URL=https://earthquake-thru-deserve-curves.trycloudflare.com
DOXI_PROXY_SECRET=PASTE_THE_EXISTING_SECRET_FROM_CLOUD_HOME_PC_HERE
# Optional, recommended before production: exact RelaxDev site origin(s), comma-separated.
# Example: https://your-project.relaxdev.app
DOXI_ALLOWED_ORIGINS=
